<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.elias.gestobar.controllers.BalanceContentController"
      styleClass="admin-root">

    <HBox alignment="CENTER_LEFT">
        <Label text="Daily Closing &amp; Balance" styleClass="admin-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnResetDay"
                text="⟳  Reset Day"
                onAction="#handleResetDay"
                styleClass="btn-danger"/>
    </HBox>

    <HBox fx:id="confirmBox"
          visible="false"
          managed="false"
          alignment="CENTER_LEFT"
          spacing="12"
          styleClass="balance-confirm-box">
        <Label text="Are you sure you want to clear all daily sales data?"
               styleClass="balance-confirm-text"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Yes, Clear" onAction="#handleConfirmReset" styleClass="btn-danger"/>
        <Button text="Cancel" onAction="#handleCancelReset" styleClass="btn-secondary"/>
    </HBox>

    <HBox spacing="16">

        <VBox styleClass="balance-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label text="€" styleClass="balance-stat-icon-blue"/>
                <Label text="Total Revenue" styleClass="balance-stat-label"/>
            </HBox>
            <Label fx:id="totalRevenueLabel" text="0.00 €" styleClass="balance-stat-value-blue"/>
        </VBox>

        <VBox styleClass="balance-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label text="📊" styleClass="balance-stat-icon"/>
                <Label text="Total Costs" styleClass="balance-stat-label"/>
            </HBox>
            <Label fx:id="totalCostsLabel" text="0.00 €" styleClass="balance-stat-value-red"/>
        </VBox>

        <VBox styleClass="balance-stat-card" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label text="↗" styleClass="balance-stat-icon-green"/>
                <Label text="Real Profit" styleClass="balance-stat-label"/>
            </HBox>
            <Label fx:id="realProfitLabel" text="0.00 €" styleClass="balance-stat-value-green"/>
        </VBox>

    </HBox>

    <VBox VBox.vgrow="ALWAYS" styleClass="admin-table-container">

        <Label text="Sales Breakdown" styleClass="balance-breakdown-title">
            <VBox.margin>
                <Insets top="14" right="16" bottom="10" left="16"/>
            </VBox.margin>
        </Label>

        <Separator/>

        <HBox styleClass="admin-table-header">
            <Label text="Product" styleClass="col-header" prefWidth="280"/>
            <Label text="Qty Sold" styleClass="col-header" prefWidth="100"/>
            <Label text="Revenue" styleClass="col-header" prefWidth="120"/>
            <Label text="Cost" styleClass="col-header" prefWidth="120"/>
            <Label text="Profit" styleClass="col-header" prefWidth="120"/>
        </HBox>

        <ScrollPane fitToWidth="true"
                    VBox.vgrow="ALWAYS"
                    styleClass="transparent-scroll">
            <VBox fx:id="breakdownContainer"
                  styleClass="transparent-container"/>
        </ScrollPane>

        <HBox fx:id="totalsRow"
              visible="false"
              managed="false"
              styleClass="balance-totals-row">
            <Label text="Totals"
                   styleClass="balance-totals-label" prefWidth="280"/>
            <Label fx:id="totalQtyLabel"
                   text="0"
                   styleClass="balance-totals-label" prefWidth="100"/>
            <Label fx:id="totalRevLabel"
                   text="0.00 €"
                   styleClass="balance-totals-value-blue" prefWidth="120"/>
            <Label fx:id="totalCostRowLabel"
                   text="0.00 €"
                   styleClass="balance-totals-value-red" prefWidth="120"/>
            <Label fx:id="totalProfitLabel"
                   text="0.00 €"
                   styleClass="balance-totals-value-green" prefWidth="120"/>
        </HBox>

    </VBox>

</VBox>
