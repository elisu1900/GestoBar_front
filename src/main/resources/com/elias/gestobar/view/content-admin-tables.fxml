<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.elias.gestobar.controllers.ContentAdminTablesController"
      styleClass="admin-root">

    <HBox alignment="CENTER_LEFT">
        <Label text="Table Management" styleClass="admin-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Add Table"
                onAction="#handleAddTable"
                styleClass="btn-primary"/>
    </HBox>

    <VBox fx:id="newTableForm"
          visible="false"
          managed="false"
          styleClass="admin-card">

        <Label text="New Table" styleClass="section-title"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <VBox spacing="4" prefWidth="160">
                <Label text="Table Number" styleClass="field-label"/>
                <TextField fx:id="newNumber"
                           promptText="e.g. 5"
                           styleClass="input-field"/>
            </VBox>
            <VBox spacing="4" prefWidth="160">
                <Label text="Capacity (seats)" styleClass="field-label"/>
                <TextField fx:id="newCapacity"
                           promptText="e.g. 4"
                           styleClass="input-field"/>
            </VBox>
            <HBox spacing="6" alignment="BOTTOM_CENTER">
                <Button text="✓" onAction="#handleConfirmNew" styleClass="btn-confirm-sm"/>
                <Button text="✕" onAction="#handleCancelNew" styleClass="btn-cancel-sm"/>
            </HBox>
        </HBox>

        <Label fx:id="newErrorLabel"
               text=""
               visible="false"
               managed="false"
               styleClass="inline-error"/>
    </VBox>

    <VBox VBox.vgrow="ALWAYS" styleClass="admin-table-container">

        <HBox styleClass="admin-table-header">
            <Label text="Table" styleClass="col-header" prefWidth="200"/>
            <Label text="Capacity" styleClass="col-header" prefWidth="200"/>
            <Label text="Actions" styleClass="col-header"/>
        </HBox>

        <ScrollPane fitToWidth="true"
                    VBox.vgrow="ALWAYS"
                    styleClass="transparent-scroll">
            <VBox fx:id="tableListContainer"
                  styleClass="transparent-container"/>
        </ScrollPane>

    </VBox>

</VBox>
