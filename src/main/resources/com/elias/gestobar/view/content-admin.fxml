<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.elias.gestobar.controllers.ContentAdminController"
      styleClass="admin-root">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT">
        <Label text="Product Administration" styleClass="admin-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnAddProduct"
                text="+ Add Product"
                onAction="#handleAddProduct"
                styleClass="btn-primary"/>
    </HBox>

    <!-- Formulario nuevo producto -->
    <VBox fx:id="newProductForm"
          visible="false"
          managed="false"
          styleClass="admin-card">

        <Label text="New Product" styleClass="section-title"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Product Name" styleClass="field-label"/>
                <TextField fx:id="newName"
                           promptText="Name"
                           styleClass="input-field"
                           maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="4" prefWidth="140">
                <Label text="Sale Price (€)" styleClass="field-label"/>
                <TextField fx:id="newSellPrice"
                           promptText="0.00"
                           styleClass="input-field"/>
            </VBox>
            <VBox spacing="4" prefWidth="140">
                <Label text="Cost Price (€)" styleClass="field-label"/>
                <TextField fx:id="newCostPrice"
                           promptText="0.00"
                           styleClass="input-field"/>
            </VBox>
            <HBox spacing="6" alignment="BOTTOM_CENTER">
                <Button text="✓" onAction="#handleConfirmNew" styleClass="btn-confirm-sm"/>
                <Button text="✕" onAction="#handleCancelNew"  styleClass="btn-cancel-sm"/>
            </HBox>
        </HBox>

        <Label fx:id="newErrorLabel"
               text=""
               visible="false"
               managed="false"
               styleClass="inline-error"/>
    </VBox>

    <!-- Tabla -->
    <VBox VBox.vgrow="ALWAYS" styleClass="admin-table-container">

        <!-- Cabecera -->
        <HBox styleClass="admin-table-header">
            <Label text="Product Name" styleClass="col-header" prefWidth="300"/>
            <Label text="Sale Price"   styleClass="col-header" prefWidth="130"/>
            <Label text="Cost Price"   styleClass="col-header" prefWidth="130"/>
            <Label text="Margin"       styleClass="col-header" prefWidth="130"/>
            <Label text="Actions"      styleClass="col-header"/>
        </HBox>

        <!-- Filas dinámicas -->
        <ScrollPane fitToWidth="true"
                    VBox.vgrow="ALWAYS"
                    styleClass="transparent-scroll">
            <VBox fx:id="productListContainer"
                  styleClass="transparent-container"/>
        </ScrollPane>

    </VBox>

</VBox>