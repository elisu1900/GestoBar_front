<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.*?>

<HBox fx:id="contentRoot" styleClass="content-root" stylesheets="@../css/styles.css" VBox.vgrow="ALWAYS"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.elias.gestobar.controllers.ContentAreaController">

    <VBox styleClass="left-column">
        <fx:include fx:id="tablePanel" source="table-panel.fxml"/>
        <Button text="🧮  Calculadora"
                onAction="#handleOpenCalculator"
                maxWidth="Infinity"
                styleClass="calc-open-btn">
            <VBox.margin>
                <Insets top="8"/>
            </VBox.margin>
        </Button>
        <padding>
            <Insets left="10.0"/>
        </padding>
    </VBox>
    <fx:include fx:id="productPanel" source="product-panel.fxml" HBox.hgrow="ALWAYS"/>
</HBox>
