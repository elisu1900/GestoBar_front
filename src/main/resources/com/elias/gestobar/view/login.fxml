<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootPane"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.elias.gestobar.controllers.LoginController"
           stylesheets="@../css/styles.css"
           minWidth="900"
           minHeight="520">

    <VBox fx:id="loginCard"
          maxWidth="320"
          maxHeight="420"
          StackPane.alignment="CENTER">

        <VBox fx:id="logoSection" alignment="CENTER">
            <ImageView fitWidth="52" fitHeight="52" preserveRatio="true">
                <image><Image url="@../images/logo.png"/></image>
            </ImageView>

            <HBox alignment="CENTER" spacing="0">
                <Label fx:id="labelGesto" text="Gesto"/>
                <Label fx:id="labelBarFX" text="Bar FX"/>
            </HBox>
        </VBox>

        <VBox fx:id="formSection">

            <Label fx:id="usernameLabel" text="Username"/>
            <TextField fx:id="usernameField"
                       promptText="Enter username"/>

            <Label fx:id="passwordLabel" text="Password"/>
            <PasswordField fx:id="passwordField"
                           promptText="Enter password"
                           onAction="#handleLogin"/>

            <Label fx:id="errorLabel"
                   text=""
                   visible="false"
                   managed="false"
                   wrapText="true"/>

            <Button fx:id="loginButton"
                    text="→  Log In"
                    maxWidth="Infinity"
                    onAction="#handleLogin">
                <VBox.margin>
                    <Insets top="10"/>
                </VBox.margin>
            </Button>

        </VBox>
    </VBox>
</StackPane>