<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="orderPanel"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.elias.gestobar.controllers.OrderPanelController"
      stylesheets="@../css/styles.css"
      styleClass="order-panel">

    <HBox alignment="CENTER_LEFT" spacing="8">

        <Label text="📋"/>

        <Label fx:id="orderTitle"
               text="No table selected"
               styleClass="order-title"/>

    </HBox>

    <Separator styleClass="order-separator"/>

    <ScrollPane fitToWidth="true"
                VBox.vgrow="ALWAYS"
                styleClass="transparent-scroll">

        <VBox fx:id="orderItemsContainer"
              spacing="0"
              styleClass="transparent-container"/>

    </ScrollPane>

    <Separator styleClass="order-separator"/>

    <HBox alignment="CENTER_LEFT">

        <Label text="Total"
               styleClass="total-label"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Label fx:id="totalLabel"
               text="0.00 €"
               styleClass="total-value"/>

    </HBox>

    <Button fx:id="moveTableButton"
            text="Mover mesa"
            maxWidth="Infinity"
            disable="true"
            onAction="#handleMoveTable"
            styleClass="move-btn"/>

    <Button fx:id="closeBillButton"
            text="Close Bill"
            maxWidth="Infinity"
            disable="true"
            onAction="#handleCloseBill"
            styleClass="success-btn"/>

</VBox>